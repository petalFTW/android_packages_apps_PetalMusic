// Gradle builds Music; platform signing lets BridgeFX do its thing.
// SPDX-License-Identifier: Apache-2.0

android_app_import {
    name: "PetalMusic",
    owner: "rab1d",
    apk: "prebuilt/app-release.apk",
    certificate: "platform",
    privileged: false,
    dex_preopt: {
        enabled: true,
    },
    // prefer the prebuilt if anything else ever claims the module name
    prefer: true,
}

// Twelve's out; Music handles audio now.
// No BridgeFX? The app mixer picks up the slack.
// BridgeController backs off while Music owns the effect.
